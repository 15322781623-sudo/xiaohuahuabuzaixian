<!DOCTYPE html>
<html style="width:100%;height:100%;margin:0;padding:0;overflow:hidden;">
<head>
  <meta charset="utf-8" />
  <title>鍜搁奔涔嬬帇</title>
  <meta name="viewport" content="width=device-width,user-scalable=no,initial-scale=1,maximum-scale=1,viewport-fit=cover" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="format-detection" content="telephone=no" />
  <meta name="renderer" content="webkit" />
  <meta name="force-rendering" content="webkit" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
  <meta name="screen-orientation" content="portrait" />
  <link rel="stylesheet" type="text/css" href="game/style-mobile.1777a.css" />
  <link rel="icon" href="game/favicon.8de18.ico" />
</head>
<body>
  <canvas id="GameCanvas" oncontextmenu="event.preventDefault()" tabindex="0"></canvas>
  <div id="splash">
    <div class="progress-bar stripes"><span style="width: 0%"></span></div>
  </div>

  <!-- ===== 0. 鐧诲綍鏁版嵁鍒濆鍖?(蹇呴』鍦ㄦ墍鏈夊叾浠栬剼鏈箣鍓? ===== -->
  <script>
  (function() {
    var TAG = '[GameLogin]';
    var loginData = null;
    var LOGIN_KEY = '__game_login_data__';

    // 鈽?0. 浼樺厛浠?URL 鍙傛暟璇诲彇 tokenId (鎵归噺鐧诲綍妯″紡)
    try {
      var urlParams = new URLSearchParams(window.location.search);
      var tokenId = urlParams.get('token');
      if (tokenId) {
        var tokenKey = '__game_login_' + tokenId + '__';
        var raw0 = localStorage.getItem(tokenKey);
        if (raw0) {
          loginData = JSON.parse(raw0);
          console.log(TAG, '鉁?浠?URL token 鍙傛暟璇诲彇鐧诲綍鏁版嵁鎴愬姛, tokenId=' + tokenId);
          localStorage.removeItem(tokenKey);
        }
      }
    } catch(e) { console.warn(TAG, 'URL token璇诲彇澶辫触:', e.message); }

    // 鈽?1. 鍥為€€: 浠?localStorage 閫氱敤 key 璇诲彇 (鍗曡处鍙风櫥褰? 璺ㄦ爣绛鹃〉鍏变韩)
    if (!loginData) {
      try {
        var raw = localStorage.getItem(LOGIN_KEY);
        if (raw) {
          loginData = JSON.parse(raw);
          console.log(TAG, '鉁?浠?localStorage 璇诲彇鐧诲綍鏁版嵁鎴愬姛');
          localStorage.removeItem(LOGIN_KEY);
        }
      } catch(e) { console.warn(TAG, 'localStorage璇诲彇澶辫触:', e.message); }
    }

    // 鍥為€€2: 浠?opener 鐨?sessionStorage 璇诲彇 (鍏煎鏃ч€昏緫)
    if (!loginData) {
      try {
        if (window.opener && window.opener.sessionStorage) {
          var raw2 = window.opener.sessionStorage.getItem(LOGIN_KEY);
          if (raw2) {
            loginData = JSON.parse(raw2);
            console.log(TAG, '浠?opener sessionStorage 璇诲彇鎴愬姛');
            window.opener.sessionStorage.removeItem(LOGIN_KEY);
          }
        }
      } catch(e) { console.warn(TAG, 'opener璇诲彇澶辫触:', e.message); }
    }

    // 鍥為€€2: 浠庤嚜韬?sessionStorage 璇诲彇
    if (!loginData) {
      try { loginData = JSON.parse(sessionStorage.getItem(LOGIN_KEY)); } catch(e) {}
    }

    // 鍥為€€3: 浠?123椤圭洰鏍煎紡鐨?localStorage 璇诲彇
    if (!loginData) {
      try {
        var pending = localStorage.getItem('_pending_login_data_');
        if (pending) {
          var pd = JSON.parse(pending);
          if (pd.account) {
            loginData = {
              info: pd.account.info || '',
              platform: pd.account.platform || 'hortor',
              platformExt: pd.account.platformExt || 'mix',
              serverId: pd.account.serverId || '0'
            };
            console.log(TAG, '浠?_pending_login_data_ 璇诲彇鎴愬姛');
          }
        }
      } catch(e) {}
    }

    if (!loginData) {
      document.body.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100vh;color:#fff;font-size:18px;background:#333;">鐧诲綍鏁版嵁涓嶅瓨鍦紝璇蜂粠鍔╂墜椤甸潰璺宠浆杩涘叆娓告垙</div>';
      return;
    }

    // 鈽?璁剧疆鍏ㄥ眬鐧诲綍鏁版嵁 (渚?1.js hook 璇诲彇)
    // 鍖归厤123椤圭洰鐨?__saveInfoData 鏍煎紡
    window.__saveInfoData = loginData;
    window.__saveData = null;
    // tokenId 浠?URL 鍙傛暟鑾峰彇锛屽彲鑳芥湭瀹氫箟
    window._gameTokenId = (typeof tokenId !== 'undefined' ? tokenId : '') || ''; // 涓嶉渶瑕佸師濮婤IN瀛楄妭锛岀洿鎺ョ敤瑙ｇ爜鍚庣殑鏁版嵁
    console.log(TAG, '鐧诲綍鏁版嵁宸叉敞鍏?',
      'platform=' + loginData.platform,
      'platformExt=' + loginData.platformExt,
      'serverId=' + loginData.serverId,
      'infoLen=' + (loginData.info ? loginData.info.length : 0));

    // 鈽?鍚屾妯″潡: UI浜嬩欢杞彂 + 鍥炴斁
    window._syncEnabled = false;
    window._syncReplay = false;

    // 鈽?鎷︽埅 Canvas 浜嬩欢鐩戝惉鍣ㄦ敞鍐岋紙蹇呴』鍦?Cocos2d 寮曟搸鍔犺浇鍓嶆墽琛岋級
    // 褰?Cocos2d 娉ㄥ唽 touch/pointer/mouse 鐩戝惉鏃讹紝淇濆瓨鍏跺洖璋冨紩鐢?    var _cocosHandlers = {};
    (function() {
      var _origAdd = HTMLCanvasElement.prototype.addEventListener;
      HTMLCanvasElement.prototype.addEventListener = function(type, fn, opts) {
        if (this.id === 'GameCanvas' || this.tagName === 'CANVAS') {
          var capture = (opts === true || (opts && opts.capture));
          var key = type + (capture ? ':capture' : '');
          if (!_cocosHandlers[key]) _cocosHandlers[key] = [];
          _cocosHandlers[key].push(fn);
        }
        return _origAdd.call(this, type, fn, opts);
      };
    })();

    // 鈽?閫氳繃淇濆瓨鐨勫洖璋冪洿鎺ユ敞鍏ヤ簨浠讹紙瀹屽叏缁曡繃 isTrusted 妫€鏌ワ級
    function injectViaHandlers(type, cx, cy) {
      // 鏋勯€犱笌鐪熷疄浜嬩欢缁撴瀯涓€鑷寸殑鍋囦簨浠跺璞?      var fakeEv = {
        type: type,
        clientX: cx, clientY: cy, pageX: cx, pageY: cy,
        screenX: cx, screenY: cy,
        button: 0, buttons: 1, which: 1,
        pointerId: 1, pointerType: 'mouse', isPrimary: true,
        width: 1, height: 1, pressure: 0.5,
        target: document.getElementById('GameCanvas'),
        currentTarget: document.getElementById('GameCanvas'),
        preventDefault: function(){}, stopPropagation: function(){},
        stopImmediatePropagation: function(){},
        touches: [], changedTouches: [], targetTouches: [],
        ctrlKey: false, shiftKey: false, altKey: false, metaKey: false,
        view: window, bubbles: true, cancelable: true, composed: true,
        isTrusted: true // 浼涓哄彲淇′簨浠?      };
      // 瑙︽懜浜嬩欢娣诲姞 touches 鏁扮粍
      if (type.indexOf('touch') >= 0) {
        var t = { identifier: 0, clientX: cx, clientY: cy, pageX: cx, pageY: cy, screenX: cx, screenY: cy, target: fakeEv.target, radiusX: 1, radiusY: 1, rotationAngle: 0, force: 1 };
        if (type === 'touchend') {
          fakeEv.changedTouches = [t];
        } else {
          fakeEv.touches = [t]; fakeEv.targetTouches = [t]; fakeEv.changedTouches = [t];
        }
      }

      var fired = false;
      // 鏌ユ壘骞惰皟鐢?Cocos2d 娉ㄥ唽鐨勫搴斿洖璋?      var searchTypes = [type];
      // pointer 浜嬩欢鍚屾椂鏌ユ壘瀵瑰簲鐨?mouse/touch 鍥炶皟
      if (type === 'pointerdown') searchTypes.push('mousedown', 'touchstart');
      if (type === 'pointermove') searchTypes.push('mousemove', 'touchmove');
      if (type === 'pointerup') searchTypes.push('mouseup', 'touchend');

      for (var i = 0; i < searchTypes.length; i++) {
        var st = searchTypes[i];
        ['false', 'true'].forEach(function(captureKey) {
          var key = st + (captureKey === 'true' ? ':capture' : '');
          var handlers = _cocosHandlers[key];
          if (handlers) {
            for (var j = 0; j < handlers.length; j++) {
              try { handlers[j].call(fakeEv.target, fakeEv); fired = true; } catch(e) {}
            }
          }
        });
      }
      return fired;
    }

    // 鈽?鐩戝惉鐖剁獥鍙ｇ殑鍚屾鎸囦护鍜屼簨浠跺洖鏀?    window.addEventListener('message', function(e) {
      if (!e.data || !e.data.type) return;
      if (e.data.type === 'INPUT_EVENT' && e.data.event) {
        var ev = e.data.event;
        try {
          var canvas = document.getElementById('GameCanvas');
          if (!canvas) return;
          window._syncReplay = true;
          var rect = canvas.getBoundingClientRect();
          var scaleX = rect.width / (ev.viewW || rect.width);
          var scaleY = rect.height / (ev.viewH || rect.height);
          var cx = ev.clientX * scaleX;
          var cy = ev.clientY * scaleY;

          // 鈽?閫氳繃鎷︽埅鐨勫洖璋冪洿鎺ユ敞鍏?          var injected = injectViaHandlers(ev.eventType, cx, cy);

          // 鈽?鍥為€€: dispatchEvent
          if (!injected) {
            var mouseEv = new MouseEvent(
              ev.eventType.replace('pointer','mouse').replace('touch','mouse'),
              { bubbles: true, cancelable: true, view: window, clientX: cx, clientY: cy, button: 0 }
            );
            canvas.dispatchEvent(mouseEv);
          }
          window._syncReplay = false;
        } catch(err) {
          window._syncReplay = false;
          console.warn(TAG, '浜嬩欢鍥炴斁澶辫触:', err.message);
        }
      }

      // 鈽?鑴氭湰娉ㄥ叆: 鎺ユ敹鐖剁獥鍙ｅ彂閫佺殑JS鑴氭湰骞舵墽琛?      if (e.data.type === 'INJECT_SCRIPT' && e.data.code) {
        try {
          var fn = new Function(e.data.code);
          fn.call(window);
          console.log('[Script] 宸叉墽琛?', e.data.name || 'unnamed');
        } catch(err) {
          console.error('[Script] 鎵ц澶辫触:', e.data.name || 'unnamed', err.message);
        }
      }
    });

    // 鈽?鑷敞鍏? 鐙珛绐楀彛鎵撳紑鏃惰嚜鍔ㄤ粠 localStorage 璇诲彇澧炲己浠ｇ爜骞舵墽琛?    if (window.parent === window) {
      (function() {
        try {
          var cached = localStorage.getItem('__game_enhance_codes__');
          if (!cached) return;
          var codes = JSON.parse(cached);
          if (!Array.isArray(codes) || codes.length === 0) return;
          console.log('[鑷敞鍏 鍙戠幇 ' + codes.length + ' 椤瑰寮轰唬鐮侊紝绛夊緟娓告垙鍒濆鍖?..');
          setTimeout(function() {
            codes.forEach(function(item) {
              try {
                var fn = new Function(item.code);
                fn.call(window);
                console.log('[鑷敞鍏 宸叉墽琛?', item.name);
              } catch(err) {
                console.error('[鑷敞鍏 鎵ц澶辫触:', item.name, err.message);
              }
            });
            console.log('[鑷敞鍏 瀹屾垚锛屽叡娉ㄥ叆 ' + codes.length + ' 椤瑰姛鑳?);
          }, 1500);
        } catch(e) {
          console.warn('[鑷敞鍏 璇诲彇澶辫触:', e.message);
        }
      })();
    }

    // 鈽?Canvas 浜嬩欢鎹曡幏: 鍚屾寮€鍚椂灏嗘搷浣滆浆鍙戠粰鐖剁獥鍙?    (function() {
      var captured = false;
      var lastMoveTime = 0;
      var MOVE_THROTTLE = 16; // ~60fps 鑺傛祦锛岄伩鍏嶈繃澶?postMessage

      var forwardEvent = function(type, e) {
        if (window._syncReplay || !window._syncEnabled || window.parent === window) return;

        // 绉诲姩浜嬩欢鑺傛祦
        if (type === 'mousemove' || type === 'pointermove' || type === 'touchmove') {
          var now = Date.now();
          if (now - lastMoveTime < MOVE_THROTTLE) return;
          lastMoveTime = now;
        }

        try {
          var data = {
            eventType: type,
            clientX: e.clientX,
            clientY: e.clientY,
            button: e.button || 0,
            viewW: window.innerWidth,
            viewH: window.innerHeight
          };
          // PointerEvent 鐗规湁灞炴€?          if (type.indexOf('pointer') === 0) {
            data.pointerId = e.pointerId || 1;
            data.pointerType = e.pointerType || 'mouse';
            data.width = e.width || 1;
            data.height = e.height || 1;
            data.pressure = e.pressure || 0.5;
          }
          window.parent.postMessage({
            type: 'GAME_INPUT_EVENT',
            tokenId: window._gameTokenId || '',
            event: data
          }, '*');
        } catch(err) {}
      };

      function setupCapture() {
        if (captured) return;
        var canvas = document.getElementById('GameCanvas');
        if (!canvas) return;
        captured = true;

        // 鈽?PointerEvent (Cocos2d 鐜颁唬鐗堟湰涓昏浣跨敤)
        canvas.addEventListener('pointerdown', function(e) { forwardEvent('pointerdown', e); }, true);
        canvas.addEventListener('pointerup', function(e) { forwardEvent('pointerup', e); }, true);
        canvas.addEventListener('pointermove', function(e) { forwardEvent('pointermove', e); }, true);
        canvas.addEventListener('pointercancel', function(e) { forwardEvent('pointercancel', e); }, true);

        // 瑙︽懜浜嬩欢 (绉诲姩绔父鎴?
        canvas.addEventListener('touchstart', function(e) { forwardEvent('touchstart', e.touches[0] || e); }, true);
        canvas.addEventListener('touchend', function(e) { forwardEvent('touchend', e.changedTouches[0] || e); }, true);
        canvas.addEventListener('touchmove', function(e) { forwardEvent('touchmove', e.touches[0] || e); }, true);

        // 榧犳爣浜嬩欢 (妗岄潰绔吋瀹?
        canvas.addEventListener('mousedown', function(e) { forwardEvent('mousedown', e); }, true);
        canvas.addEventListener('mouseup', function(e) { forwardEvent('mouseup', e); }, true);
        canvas.addEventListener('mousemove', function(e) { forwardEvent('mousemove', e); }, true);

        console.log(TAG, '鉁?Canvas浜嬩欢鎹曡幏宸插畨瑁?(pointer+touch+mouse)');
      }

      // 绛夊緟Canvas鍔犺浇
      if (document.getElementById('GameCanvas')) {
        setupCapture();
      } else {
        var observer = new MutationObserver(function() {
          if (document.getElementById('GameCanvas')) {
            setupCapture();
            observer.disconnect();
          }
        });
        observer.observe(document.body, { childList: true, subtree: true });
      }
    })();
  })();
  </script>

  <!-- ===== 1. SDK Mock (wx + HSDK) ===== -->
  <script>
  (function() {
    window.wx = window.wx || {
      getSystemInfo: function() { return { platform: 'android', brand: 'Android', system: 'Android 12', model: 'Android' }; },
      getStorageInfo: function() { return { keys: [] }; },
      onShow: function(cb) { if (cb) setTimeout(function() { cb({ scene: '1001', query: {} }); }, 50); },
      onHide: function() {},
      login: function(opts) { if (opts && opts.success) setTimeout(function() { opts.success({ code: 'wx_mock_' + Date.now() }); }, 100); },
      request: function(opts) { if (opts && opts.success) setTimeout(function() { opts.success({ data: '{}' }); }, 50); },
      shareAppMessage: function(opts) { if (opts && opts.success) setTimeout(function() { opts.success(); }, 50); },
      showShareMenu: function(opts) { if (opts && opts.success) opts.success(); },
      hideShareMenu: function(opts) { if (opts && opts.success) opts.success(); },
      getClipboardData: function(opts) { if (opts && opts.success) opts.success({ data: '' }); },
      setClipboardData: function(opts) {
        if (opts && opts.data && navigator.clipboard) { navigator.clipboard.writeText(opts.data).catch(function(){}); }
        if (opts && opts.success) setTimeout(function() { opts.success(); }, 50);
      },
      showModal: function(opts) { if (opts && opts.success) opts.success({ confirm: true }); },
      showToast: function(opts) { if (opts && opts.success) opts.success(); },
      showLoading: function(opts) { if (opts && opts.success) opts.success(); },
      hideLoading: function(opts) { if (opts && opts.success) opts.success(); },
      vibrateShort: function(opts) { if (opts && opts.success) opts.success(); },
      getSetting: function(opts) { if (opts && opts.success) opts.success({ authSetting: {} }); },
      authorize: function(opts) { if (opts && opts.success) opts.success(); },
      previewImage: function() {},
      getImageInfo: function(opts) { if (opts && opts.success) opts.success({ width: 100, height: 100, path: opts.src || '' }); },
      downloadFile: function(opts) { if (opts && opts.success) setTimeout(function() { opts.success({ tempFilePath: opts.url || '' }); }, 100); },
      uploadFile: function(opts) { if (opts && opts.success) setTimeout(function() { opts.success({ data: '{}' }); }, 100); },
      saveImageToPhotosAlbum: function() {},
      createInnerAudioContext: function() { return { play:function(){}, pause:function(){}, stop:function(){}, destroy:function(){} }; },
      getNetworkType: function(opts) { if (opts && opts.success) opts.success({ networkType: 'wifi' }); },
      onNetworkStatusChange: function() {},
      exitMiniProgram: function() {},
      navigateToMiniProgram: function(opts) { if (opts && opts.success) opts.success(); },
    };
    window.HSDK = window.HSDK || {
      _callbacks: [],
      onLogin: function(data) {
        if (data && typeof data === 'function') window.HSDK._callbacks.push(data);
        else if (data && data.listener) window.HSDK._callbacks.push(data.listener);
        setTimeout(function() {
          window.HSDK._callbacks.forEach(function(cb) {
            try { cb({ userSdk: { isNewUser: false }, token: 'pending' }); } catch(e) {}
          });
        }, 200);
      },
      reportLoginState: function() {},
      onAddictionQuit: function() {},
      getGsSetting: function() { return { version: '0.1.0', appid: 'xyzw_mix' }; },
      reportData: function() {},
      loginSuccess: function() {},
      loginFail: function() {},
    };
    window.__HORTOR_SDK__ = window.__HORTOR_SDK__ || { tga: { track: function(){}, tga: null } };
    window.__HORTOR_SDK__.tga.tga = window.__HORTOR_SDK__.tga;
    window._hsdkInit = 1;
    window.checkUpdate = 1;
    // 鎷︽埅闃诲瀵硅瘽妗?    window.alert = function(msg) { console.log('[Game] alert:', String(msg||'').substring(0,100)); };
    window.confirm = function() { return true; };
    window.prompt = function(msg, def) { return def !== undefined ? String(def) : ''; };
    console.log('[GameLogin] SDK Mock 鍒濆鍖栧畬鎴?);
  })();
  </script>

  <!-- ===== 2. LoginObserver Hook (蹇呴』鍦?cocos2d 寮曟搸涔嬪墠) ===== -->
  <script>
  (function() {
    'use strict';
    var TAG = '[LoginHook]';
    var win = window;

    function simpleHash(str) {
      var h = 0;
      for (var i = 0; i < str.length; i++) { h = ((h << 5) - h + str.charCodeAt(i)) | 0; }
      return (h >>> 0).toString(36);
    }
    function generateUUID() {
      return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
        var r = Math.random() * 16 | 0;
        return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);
      });
    }
    function getDeviceUniqueId() {
      try {
        var cacheKey = '__deviceUniqueId_' + (win.__saveInfoData && win.__saveInfoData.info ? simpleHash(win.__saveInfoData.info) : 'default');
        var id = localStorage.getItem(cacheKey);
        if (id && id.indexOf('DID-') === 0) return id;
        id = 'DID-' + generateUUID();
        localStorage.setItem(cacheKey, id);
        return id;
      } catch(e) { return 'DID-' + generateUUID(); }
    }

    win.__injectLoginData = function(data) {
      if (data) win.__saveInfoData = data;
      if (win.__authUserResolve) { win.__authUserResolve(); win.__authUserResolve = null; }
    };

    function applyOverride(params) {
      try { params.deviceUniqueId = getDeviceUniqueId(); } catch(e) {}
      if (win.__saveInfoData) {
        var d = win.__saveInfoData;
        if (d.info) params.info = d.info;
        if (d.platform != null) params.platform = d.platform;
        if (d.platformExt) params.platformExt = d.platformExt;
        if (!win.__firstAuthDone) {
          win.__firstAuthDone = true;
          if (d.serverId) params.serverId = d.serverId;
        }
        console.log(TAG, 'applyOverride: plat=' + params.platform + ' srv=' + params.serverId);
      }
    }

    function _hookAuthUser(loginService, name) {
      if (loginService.__loginHooked) return;
      loginService.__loginHooked = true;
      var orig = loginService.authUser;
      if (typeof orig !== 'function') { loginService.__loginHooked = false; return; }
      loginService.authUser = function(params) {
        var self = this;
        if (win.__saveInfoData) {
          applyOverride(params);
          var result = orig.call(self, params);
          if (result && typeof result.then === 'function') {
            result.then(function(res) {
              if (res && res.code) console.warn(TAG, 'authUser杩斿洖code=' + res.code);
              else console.log(TAG, '鉁?authUser 鎴愬姛!');
            });
          }
          return result;
        }
        console.log(TAG, 'authUser 绛夊緟鏁版嵁娉ㄥ叆...');
        return new Promise(function(resolve) {
          win.__authUserResolve = function() {
            applyOverride(params);
            orig.call(self, params).then(resolve);
          };
        });
      };
      if (typeof loginService.serverList === 'function' && !loginService.__serverListHooked) {
        loginService.__serverListHooked = true;
        var origSL = loginService.serverList;
        loginService.serverList = function(params) {
          try { params.deviceUniqueId = getDeviceUniqueId(); } catch(e) {}
          if (win.__saveInfoData) {
            var d = win.__saveInfoData;
            if (d.info) params.info = d.info;
            if (d.platform != null) params.platform = d.platform;
            if (d.platformExt) params.platformExt = d.platformExt;
            if (d.serverId) params.serverId = d.serverId;
          }
          return origSL.call(this, params);
        };
      }
      console.log(TAG, 'authUser 宸瞙ook (' + name + ')');
    }

    function scanAndHook(mod) {
      if (!mod || mod.__loginScanned) return;
      try {
        for (var _i = 0, _keys = Object.keys(mod); _i < _keys.length; _i++) {
          var val = mod[_keys[_i]];
          if (val && typeof val === 'object' && typeof val.authUser === 'function') {
            _hookAuthUser(val, _keys[_i]);
            mod.__loginScanned = true;
          }
        }
      } catch(e) {}
    }

    // Hook __require 浠ユ嫤鎴父鎴忔ā鍧楀姞杞?    var _realRequire = null;
    Object.defineProperty(win, '__require', {
      configurable: true,
      enumerable: true,
      get: function() { return _realRequire; },
      set: function(fn) {
        var wrapped = function(id) {
          var mod = fn.apply(this, arguments);
          scanAndHook(mod);
          return mod;
        };
        try { Object.assign(wrapped, fn); } catch(e) {}
        _realRequire = wrapped;
        console.log(TAG, '__require 宸插寘瑁?);
      }
    });
    console.log(TAG, 'LoginObserver 宸插氨缁?);
  })();
  </script>

  <!-- ===== 3. Cocos2d 寮曟搸 (鏈湴鏂囦欢) ===== -->
  <script src="game/cocos2d-js-min.a5841.js" charset="utf-8"></script>

  <!-- ===== 3.5 Patch.js: SDK琛ヤ竵 + Canvas鏂瑰悜淇 + Tampermonkey polyfill ===== -->
  <script src="game/patch.js" charset="utf-8"></script>

  <!-- ===== 4. 娓告垙閰嶇疆 (鏈湴鏂囦欢) ===== -->
  <script src="game/src/settings.js" charset="utf-8"></script>
  <script src="game/game-defines.a175e.js" charset="utf-8"></script>
  <!-- 鈽?server鎸囧悜鏈湴: internal bundle鍜宩sList浠庢湰鍦板姞杞?-->
  <!-- 鈽?杩滅▼bundle(game/launcher绛?鐢?installRemoteAssetLoader() 鐙珛澶勭悊CDN -->
  <script>
  if (window._CCSettings) {
    window._CCSettings.server = window.location.origin + '/game/assets/';
    console.log('[boot] server宸茶缃?', window._CCSettings.server);
    console.log('[boot] jsList:', window._CCSettings.jsList);
  }
  </script>

  <!-- ===== 5. 娓告垙鍏ュ彛 main.js (鏈湴鏂囦欢) ===== -->
  <script src="game/main.2a00e.js" charset="utf-8"></script>

  <!-- ===== 5.5 boot.js: 瑕嗙洊 boot() 鈥?manifest鑾峰彇 + 鐗堟湰閿佸畾 + CDN璧勬簮鍔犺浇鍣?===== -->
  <script src="game/boot.js" charset="utf-8"></script>

  <!-- ===== 5.6 Bundle涓嬭浇鍣ㄤ慨澶? 纭繚bundle涓嬭浇璧拌嚜瀹氫箟涓嬭浇鍣ㄨ€岄潪Cocos榛樿 ===== -->
  <!-- 鈽?闂: Cocos浠诲姟绠￠亾灏哹undle鍚嶈В鏋愪负缁濆URL, downloadBundle鐩存帴鐢ㄨ缁濆URL -->
  <!-- 鈽?杩欏鑷磖emote bundle(launcher/main)浠庢湰鍦板姞杞借€岄潪CDN -->
  <!-- 鈽?瑙ｅ喅: 鍦╥nstallRemoteAssetLoader涔嬪墠娉ㄥ唽bundle涓嬭浇鍣? 鐢ㄧ浉瀵筓RL+convertAssets -->
  <script>
  (function() {
    var GAME_PREFIX = window.location.origin + '/game/';
    var _origInstall = window.installRemoteAssetLoader;
    window.installRemoteAssetLoader = function() {
      var dl = cc.assetManager.downloader;
      // 淇濆瓨鍘熷涓嬭浇鍣ㄥ紩鐢?      var _origJsonDl = dl._downloaders['.json'];
      var _origScriptDl = dl._downloaders['.js'];

      // 鈽?鍏抽敭: 鍏堝寘瑁?convertAssets, 鍐嶈皟鐢?installRemoteAssetLoader
      // installRemoteAssetLoader 鍐呴儴鐨?toRemoteUrl 闂寘浼氭崟鑾峰寘瑁呭悗鐨?convertAssets
      var _origConvert = window.convertAssets;
      window.convertAssets = function(url) {
        var result = _origConvert(url);
        if (result === url && typeof url === 'string' &&
            !url.startsWith('http') && !url.startsWith('//') &&
            !url.startsWith('/') && !url.startsWith('.')) {
          return GAME_PREFIX + url;
        }
        return result;
      };

      // 璋冪敤鍘熷 installRemoteAssetLoader (toRemoteUrl 灏嗕娇鐢ㄥ寘瑁呭悗鐨?convertAssets)
      _origInstall();

      // 鈽?鍦╥nstallRemoteAssetLoader涔嬪悗瑕嗙洊bundle涓嬭浇鍣?      // 濮嬬粓鐢ㄧ浉瀵筓RL, 璁﹖oRemoteUrl/convertAssets姝ｇ‘澶勭悊
      dl._downloaders['bundle'] = function(url, options, onComplete) {
        var bundleName = cc.path.basename(url);
        var base = 'assets/' + bundleName;
        var version = options.version || (dl.bundleVers && dl.bundleVers[bundleName]);
        if (!version && bundleName !== cc.AssetManager.BuiltinBundleName.INTERNAL) {
          onComplete && onComplete(new Error('[BundleFix] missing version: ' + bundleName));
          return;
        }
        var versionPart = version ? version + '.' : '';
        var configUrl = base + '/config.' + versionPart + 'json';
        var indexUrl = base + '/index.' + versionPart + 'js';
        console.log('[BundleFix]', bundleName, '鈫?config:', configUrl, 'index:', indexUrl);

        var finished = 0, error = null, config = null;
        function done(err) {
          if (err) error = err;
          finished++;
          if (finished === 2) onComplete && onComplete(error, config);
        }
        _origJsonDl(window.convertAssets(configUrl), options, function(err, data) {
          if (err) error = err;
          if (data) {
            var remoteBase = window.convertAssets(base);
            data.base = remoteBase + '/';
            config = data;
          }
          done(err);
        });
        // 鈽?index鍙兘涓?jsc鍔犲瘑鏂囦欢, 鐢╠l.download璧癲ownloadScript瑙ｅ瘑閾?        var convertedIndexUrl = window.convertAssets(indexUrl);
        dl.download(bundleName + '-index', convertedIndexUrl, '.js', options, done);
      };

      console.log('[BundleFix] 鑷畾涔塨undle涓嬭浇鍣ㄥ凡娉ㄥ唽 + convertAssets宸插寘瑁?);
    };
  })();
  </script>

  <!-- ===== 6. 鍚姩閫昏緫 ===== -->
  <script>
  (function() {
    'use strict';
    var TAG = '[boot]';

    // 灏哄鍒濆鍖?    document.documentElement.style.width = window.innerWidth + 'px';
    document.documentElement.style.height = window.innerHeight + 'px';
    document.body.style.width = window.innerWidth + 'px';
    document.body.style.height = window.innerHeight + 'px';
    window.addEventListener('resize', function() {
      document.documentElement.style.width = window.innerWidth + 'px';
      document.documentElement.style.height = window.innerHeight + 'px';
      document.body.style.width = window.innerWidth + 'px';
      document.body.style.height = window.innerHeight + 'px';
    });

    // Canvas resize
    window.addEventListener('resize', function() {
      if (typeof cc === 'undefined' || !cc.view) return;
      setTimeout(function() {
        try {
          var w = window.innerWidth, h = window.innerHeight;
          var canvas = document.getElementById('GameCanvas');
          if (canvas) {
            var dpr = window.devicePixelRatio || 1;
            canvas.style.width = w + 'px';
            canvas.style.height = h + 'px';
            canvas.width = Math.round(w * dpr);
            canvas.height = Math.round(h * dpr);
            cc.view.setFrameSize(w, h);
          }
          cc.view.resizeWithBrowserSize(true);
        } catch(e) {}
      }, 100);
    });

    // Splash杩涘害
    var splash = document.getElementById('splash');
    var bar = splash && splash.querySelector('.progress-bar span');
    if (bar) bar.style.width = '50%';

    // 鍚姩!
    window.HtmlIsLoaded = true;
    if (typeof cc === 'undefined') {
      console.error(TAG, '鉂?cc 鏈畾涔夛紝寮曟搸鍔犺浇澶辫触!');
      if (splash) {
        splash.innerHTML = '<div style="color:#ff6b6b;font-size:14px;text-align:center;padding:20px;">寮曟搸鍔犺浇澶辫触锛岃鍒锋柊椤甸潰閲嶈瘯</div>';
        splash.style.opacity = '1';
        splash.style.display = 'flex';
        splash.style.alignItems = 'center';
        splash.style.justifyContent = 'center';
      }
      return;
    }
    console.log(TAG, '寮曟搸鍔犺浇鎴愬姛, 绛夊緟 boot()...');
    // boot.js 宸茶鐩?window.boot() (鍚玬anifest鑾峰彇+CDN璧勬簮鍔犺浇)
    // main.js 涔熷畾涔変簡 window.boot() 浣?boot.js 鍚庡姞杞? 浠?boot.js 涓哄噯
    if (typeof window.boot === 'function') {
      console.log(TAG, '璋冪敤 boot.js boot() (瀹屾暣鍚姩娴佺▼)...');
      window.boot().catch(function(err) {
        console.error(TAG, 'boot澶辫触:', err.message, err.stack);
        if (splash) {
          splash.innerHTML = '<div style="color:#ff6b6b;font-size:14px;text-align:center;padding:20px;line-height:1.8;">娓告垙鍚姩澶辫触<br>' + err.message + '<br><br><span style="font-size:12px;color:#999;">璇锋鏌ョ綉缁滆繛鎺? CDN璧勬簮闇€瑕佸彲璁块棶</span></div>';
          splash.style.opacity = '1';
          splash.style.display = 'flex';
          splash.style.alignItems = 'center';
          splash.style.justifyContent = 'center';
        }
      });
    } else {
      console.error(TAG, 'window.boot 鏈畾涔? boot.js 鍙兘鏈姞杞?);
    }
  })();
  </script>
</body>
</html>
